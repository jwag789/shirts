{
  "name": "shirts-storefront",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "kill $(lsof -ti :4242) 2>/dev/null; true",
    "dev": "concurrently -n vite,server -c cyan,yellow \"vite\" \"nodemon --watch server --watch src/data/products.js --ext js,json server/index.js\"",
    "build": "vite build && node scripts/prerender.js",
    "preview": "vite preview",
    "server": "nodemon --watch server --watch src/data/products.js --ext js,json server/index.js",
    "start": "npm run build && node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.42.0",
    "pg": "^8.21.0",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "vue": "^3.5.13",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^10.0.1",
    "happy-dom": "^20.10.6",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "vite": "^6.3.1",
    "vitest": "^2.1.9"
  }
}
